{
  "name": "pi-agent-stack",
  "version": "1.0.1",
  "description": "A chartered project-manager agent plus the specialist team it delegates to: kernel/charter pm, pack-based intake interview, researcher, oracle, worker, and the ship-gate reviewers. Bundles the subagent runtime and the execution pipeline.",
  "keywords": [
    "pi",
    "pi-package",
    "ai",
    "agent",
    "project-management",
    "personas"
  ],
  "license": "MIT",
  "type": "module",
  "author": "Kristian Gray",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KrisGray/pi-agent-stack.git"
  },
  "homepage": "https://github.com/KrisGray/pi-agent-stack#readme",
  "bugs": {
    "url": "https://github.com/KrisGray/pi-agent-stack/issues"
  },
  "files": [
    "!**/__pycache__",
    "agents/",
    "bin/",
    "templates/",
    "examples/",
    "docs/",
    ".pi/prompts/",
    "CHANGELOG.md",
    "THIRD-PARTY-NOTICES.md",
    "LICENSE",
    "README.md"
  ],
  "dependencies": {
    "@chankov/agent-skills": "0.4.2",
    "pi-ask-user": "0.15.0",
    "pi-prompt-template-model": "0.12.2",
    "pi-subagents": "0.66.0"
  },
  "pi": {
    "extensions": [
      "./node_modules/pi-subagents/index.ts",
      "./node_modules/pi-prompt-template-model/index.ts",
      "./node_modules/pi-ask-user/index.ts"
    ],
    "skills": [
      "./node_modules/@chankov/agent-skills/skills",
      "./node_modules/pi-subagents/skills",
      "./node_modules/pi-ask-user/skills",
      "./node_modules/pi-prompt-template-model/skills"
    ],
    "prompts": [
      "./.pi/prompts",
      "./node_modules/@chankov/agent-skills/.pi/prompts/*.md",
      "!./node_modules/@chankov/agent-skills/.pi/prompts/spec.md",
      "!./node_modules/@chankov/agent-skills/.pi/prompts/plan.md",
      "!./node_modules/@chankov/agent-skills/.pi/prompts/doctor-agent-skills.md",
      "!./node_modules/@chankov/agent-skills/.pi/prompts/setup-agent-skills.md"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "semantic-release": "^25.0.9"
  }
}
